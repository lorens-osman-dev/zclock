{
  "name": "zclock",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:tests": "rm -rf dist-tests && tsc -p tests/tsconfig.json",
    "build:tools": "rm -rf dist-tools && tsc -p scripts/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "npm run build && npm run build:tests && node --test dist-tests/tests/*.test.js",
    "check": "bash scripts/check.sh",
    "pack": "bash scripts/pack.sh",
    "shell-smoke": "bash scripts/shell-smoke.sh",
    "install:extension": "bash scripts/install.sh",
    "uninstall": "bash scripts/uninstall.sh",
    "dev": "npm run uninstall && npm run install:extension -- --mode development && bash scripts/dev.sh"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@girs/gjs": "^5.6.0",
    "@girs/gnome-shell": "~50.0.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "adm-zip": "^0.6.1",
    "pngjs": "^7.0.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}