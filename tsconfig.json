{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dissts/dist",
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "noEmit": true,
    "removeComments": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": []
  },
  "include": [
    "ambient.d.ts",
    "src/**/*.ts"
  ]
}
