{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": []
  },
  "include": [
    "ambient.d.ts",
    "extension.ts",
    "prefs.ts",
    "src/**/*.ts"
  ]
}
